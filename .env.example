# Public variables are bundled into browser assets. Never place secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser client (optional until the integration phase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only variables
SUPABASE_SERVICE_ROLE_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a static HTTPS URI registered in TikTok Login Kit.
TIKTOK_REDIRECT_URI=
# Generate 32 random bytes and encode them as base64. Keep server-side only.
TIKTOK_TOKEN_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
